# Copy to .env and fill these values from your Meta developer app.
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
META_GRAPH_VERSION=v24.0
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
IG_REDIRECT_URI=http://localhost:8787/oauth/instagram/callback
FB_REDIRECT_URI=http://localhost:8787/oauth/facebook/callback
IG_SCOPES=instagram_business_basic,instagram_business_manage_insights
FB_SCOPES=pages_show_list,pages_read_engagement,pages_read_user_content,read_insights
